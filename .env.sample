# ---------- Gateway (Rust) ----------
# 32-byte master key for encrypting provider API keys at rest (64 hex chars or base64).
# Generate: openssl rand -hex 32   — in production, inject from your KMS / Vault.
AICH_MASTER_KEY=
# Session signing secret (>= 32 chars). Generate: openssl rand -base64 48
AICH_JWT_SECRET=
# First admin account (created on startup if missing)
AICH_ADMIN_EMAIL=admin@example.com
AICH_ADMIN_PASSWORD=
# Optional
# DATABASE_URL=postgres://aich:aich@localhost:5432/aich      (set by docker-compose)
# REDIS_URL=redis://localhost:6379                           (in-memory fallback when unset)
# AICH_BIND=0.0.0.0:8080
# AICH_LOG_BODIES=false            # store prompt/response bodies in request logs (never for ZDR users)
# AICH_MAX_ATTEMPTS=3              # failover attempts per request (adjusted by plan priority)
# AICH_SIGNUP_BONUS_CREDITS=200000
# AICH_SELF_SERVICE_PLANS=false    # let users switch to paid plans without checkout (demo only)
# AICH_CORS_ORIGINS=               # comma-separated; empty = allow any origin
# AICH_LOG_FORMAT=json
# RUST_LOG=info

# ---------- Docker compose ----------
POSTGRES_PASSWORD=aich
PUBLIC_API_BASE_URL=http://localhost:8080/v1
