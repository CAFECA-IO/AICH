# Quick start: ./scripts/init_env.sh fills the two secrets below for you.
# The first person to sign in (CAFECA or email) automatically becomes the administrator.

# ---------- Gateway (Rust) ----------
# 32-byte master key for encrypting provider API keys at rest (64 hex chars or base64).
# Generate: openssl rand -hex 32   — in production, inject from your KMS / Vault.
AICH_MASTER_KEY=
# Session signing secret (>= 32 chars). Generate: openssl rand -base64 48
AICH_JWT_SECRET=
# Optional break-glass admin for headless setups (created on startup if both are set).
# It does not stop the first real user from becoming admin.
# AICH_ADMIN_EMAIL=
# AICH_ADMIN_PASSWORD=
# Sign in with CAFECA (https://cafeca.io) — passkey login, no client ID / API key needed.
# Exact web origin(s) users sign in from (scheme://host[:port], comma-separated). Must match the browser address bar.
AICH_CAFECA_SITE_ORIGINS=http://localhost:3000
# AICH_CAFECA_WALLET=https://cafeca.io   # set empty to disable CAFECA sign-in
# AICH_CAFECA_RPC=                        # override the RPC used for ERC-1271 verification

# Optional
# DATABASE_URL=postgres://aich:aich@localhost:5432/aich      (set by docker-compose)
# REDIS_URL=redis://localhost:6379                           (in-memory fallback when unset)
# AICH_BIND=0.0.0.0:8080
# AICH_LOG_BODIES=false            # store prompt/response bodies in request logs (never for ZDR users)
# AICH_MAX_ATTEMPTS=3              # failover attempts per request (adjusted by plan priority)
# AICH_SIGNUP_BONUS_CREDITS=200000
# AICH_SELF_SERVICE_PLANS=false    # let users switch to paid plans without checkout (demo only)
# AICH_CORS_ORIGINS=               # comma-separated; empty = allow any origin
# AICH_LOG_FORMAT=json
# RUST_LOG=info

# ---------- npm run swarm (single port, from source) ----------
# SWARM_PORT=10016                 # Web UI + /v1 API
# SWARM_HOST=0.0.0.0
# SWARM_PUBLIC_URL=http://localhost:10016   # address users open; also added to CAFECA site origins
# SWARM_GATEWAY_PORT=10017         # internal, bound to 127.0.0.1
# SWARM_PG_PORT=10018              # docker Postgres on 127.0.0.1 (ignored when DATABASE_URL is set)
# SWARM_REDIS_PORT=10019

# ---------- Docker compose ----------
POSTGRES_PASSWORD=aich
PUBLIC_API_BASE_URL=http://localhost:8080/v1
